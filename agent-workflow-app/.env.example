# ─────────────────────────────────────────────────────────────────────────────
# Agent Workflow Console — environment variables
# Copy this file to `.env.local` for local development. All variables must be
# prefixed with VITE_ to be exposed to the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# REST API base URL (no trailing slash). Empty string = same origin.
VITE_API_BASE_URL=http://localhost:5089

# SignalR hub URL. If empty, falls back to `${VITE_API_BASE_URL}/hubs/workflow`.
VITE_SIGNALR_HUB_URL=http://localhost:5089/hubs/workflow

# Authentication mode: "mock" | "entra"
#   mock  — local dev login (any non-empty username) — DEFAULT
#   entra — Microsoft Entra ID / Azure AD via MSAL
VITE_AUTH_MODE=mock

# ── Microsoft Entra ID / Azure AD (only required when VITE_AUTH_MODE=entra) ──
# App registration's Application (client) ID.
VITE_ENTRA_CLIENT_ID=
# Tenant — use a tenant GUID, your tenant domain, or "common" / "organizations".
VITE_ENTRA_TENANT_ID=common
# Redirect URI registered in the app registration. Must match exactly.
# For static hosting use the page that owns the auth flow, e.g. https://app.example.com/
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/
# Space-separated API scopes requested at login (besides openid/profile/email).
# Example: api://1234abcd-.../access_as_user
VITE_ENTRA_API_SCOPES=

# Optional: simulate backend latency in mock SignalR client (ms).
VITE_MOCK_LATENCY_MS=900
