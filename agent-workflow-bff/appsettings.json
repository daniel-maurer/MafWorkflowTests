{
  "Auth": {
    "Mode": "Mock"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id-or-domain>",
    "ClientId": "<api-app-registration-client-id>",
    "Audience": "api://<api-app-registration-client-id>"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "WorkflowConfig": {
    "Folder": "Workflows",
    "ReloadOnChange": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
